#!/usr/bin/env python3
"""Loopback HTTP gateway with a static bearer token and fixed-window rate limiting.

Spec: SPEC-loopback-gateway v0.1.4, product v0.1.0.
Standard library only. Target platform: POSIX (Ubuntu, macOS), Python 3.12.
"""

from __future__ import annotations

import codecs
import http.client
import json
import re
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

SPEC_VERSION = "0.1.4"
PRODUCT_NAME = "loopback-gateway"
PRODUCT_VERSION = "0.1.0"

MAX_UPSTREAM_BODY = 65536
UPSTREAM_TIMEOUT_SECONDS = 1.0
MAX_CLOCK_MS = (1 << 53) - 1

TOKEN_RE = re.compile(r"[A-Za-z0-9_-]{8,64}\Z")
DIGITS_RE = re.compile(r"[0-9]+\Z")
CLOCK_RE = re.compile(rb"[0-9]+\n?\Z")

CONFIG_KEYS = frozenset({"upstream_port", "token", "limit", "window_ms"})

HELP_TEXT = """usage: serve --config CONFIG --port PORT [--clock-file FILE]
       serve --help
       serve --version

Loopback HTTP gateway with a static bearer token and fixed-window rate limiting.

commands:
  serve                 start the loopback gateway (default command)

options:
  --config CONFIG       JSON configuration file (required)
  --port PORT           loopback port to bind, ASCII digits 0..65535;
                        0 selects an ephemeral port (required)
  --clock-file FILE     read the clock, in milliseconds, from FILE on each request
  --help                show this help and exit
  --version             print the product version and exit

The gateway exposes GET /health and GET /proxy on 127.0.0.1 only.
"""


class CliError(Exception):
    """A controlled command-line or configuration failure."""

    def __init__(self, message: str, exit_code: int) -> None:
        super().__init__(message)
        self.message = message
        self.exit_code = exit_code


class ClockError(Exception):
    """The clock source is invalid, unreadable, out of range or regressing."""


def _write_stdout(text: str) -> None:
    sys.stdout.buffer.write(text.encode("utf-8"))
    sys.stdout.buffer.flush()


def _write_stderr(text: str) -> None:
    sys.stderr.buffer.write(text.encode("utf-8"))
    sys.stderr.buffer.flush()


def _reject_constant(value: str) -> None:
    raise ValueError(f"non-finite number not allowed: {value}")


def _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate key: {key}")
        result[key] = value
    return result


def load_config(path: str) -> dict[str, object]:
    """Read and validate CONFIG.  Raises CliError with the contractual exit code."""
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError as exc:
        raise CliError(f"cannot read config file: {exc}", 3) from None

    if raw.startswith(codecs.BOM_UTF8) or raw.startswith((b"\xff\xfe", b"\xfe\xff")):
        raise CliError("config file must not start with a byte-order mark", 2)
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise CliError(f"config file is not valid UTF-8: {exc.reason}", 2) from None
    try:
        data = json.loads(
            text,
            object_pairs_hook=_unique_object,
            parse_constant=_reject_constant,
        )
    except (json.JSONDecodeError, ValueError) as exc:
        raise CliError(f"invalid config JSON: {exc}", 2) from None

    if not isinstance(data, dict):
        raise CliError("config must be a JSON object", 2)
    if set(data) != CONFIG_KEYS:
        raise CliError(
            "config must contain exactly upstream_port, token, limit, window_ms", 2
        )

    upstream_port = data["upstream_port"]
    if not _is_int(upstream_port) or not 1 <= upstream_port <= 65535:
        raise CliError("upstream_port must be an integer in 1..65535", 2)

    token = data["token"]
    if not isinstance(token, str) or TOKEN_RE.fullmatch(token) is None:
        raise CliError("token must match [A-Za-z0-9_-]{8,64}", 2)

    limit = data["limit"]
    if not _is_int(limit) or not 1 <= limit <= 1000:
        raise CliError("limit must be an integer in 1..1000", 2)

    window_ms = data["window_ms"]
    if not _is_int(window_ms) or not 1 <= window_ms <= 60000:
        raise CliError("window_ms must be an integer in 1..60000", 2)

    return data


def _is_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def parse_port(raw: str) -> int:
    if DIGITS_RE.fullmatch(raw) is None:
        raise CliError("--port must contain ASCII digits only", 2)
    value = int(raw)
    if value > 65535:
        raise CliError("--port must be in 0..65535", 2)
    return value


def parse_arguments(argv: list[str]) -> dict[str, object]:
    if "--version" in argv:
        return {"action": "version"}
    if "--help" in argv:
        return {"action": "help"}

    values: dict[str, str] = {}
    options = ("--config", "--port", "--clock-file")
    index = 0
    while index < len(argv):
        token = argv[index]
        matched = None
        for option in options:
            if token == option:
                if option in values:
                    raise CliError(f"{option} was given more than once", 2)
                if index + 1 >= len(argv) or argv[index + 1].startswith("--"):
                    raise CliError(f"{option} requires a value", 2)
                values[option] = argv[index + 1]
                matched = option
                index += 2
                break
            if token.startswith(option + "="):
                if option in values:
                    raise CliError(f"{option} was given more than once", 2)
                values[option] = token[len(option) + 1 :]
                matched = option
                index += 1
                break
        if matched is None:
            raise CliError(f"unrecognized argument: {token}", 2)

    if "--config" not in values:
        raise CliError("--config is required", 2)
    if "--port" not in values:
        raise CliError("--port is required", 2)

    return {
        "action": "serve",
        "config": values["--config"],
        "port": parse_port(values["--port"]),
        "clock_file": values.get("--clock-file"),
    }


class Gateway:
    """Configuration-derived state shared by all request handler threads."""

    def __init__(
        self,
        *,
        upstream_port: int,
        token: str,
        limit: int,
        window_ms: int,
        clock_file: str | None,
    ) -> None:
        self.upstream_port = upstream_port
        self.token = token
        self.limit = limit
        self.window_ms = window_ms
        self.clock_file = clock_file
        self._lock = threading.Lock()
        self._window: int | None = None
        self._used = 0
        self._last_clock: int | None = None

    def reserve(self) -> bool:
        """Validate the clock and atomically reserve one quota slot."""
        with self._lock:
            now = self._read_clock()
            window = now // self.window_ms
            if window != self._window:
                self._window = window
                self._used = 0
            if self._used >= self.limit:
                return False
            self._used += 1
            return True

    def _read_clock(self) -> int:
        if self.clock_file is None:
            return time.monotonic_ns() // 1_000_000
        try:
            with open(self.clock_file, "rb") as handle:
                data = handle.read()
        except OSError:
            raise ClockError from None
        if CLOCK_RE.fullmatch(data) is None:
            raise ClockError
        digits = data[:-1] if data.endswith(b"\n") else data
        if not digits:
            raise ClockError
        try:
            value = int(digits)
        except ValueError:
            raise ClockError from None
        if value > MAX_CLOCK_MS:
            raise ClockError
        if self._last_clock is not None and value < self._last_clock:
            raise ClockError
        self._last_clock = value
        return value


def _json_bytes(payload: dict[str, object]) -> bytes:
    return (
        json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n"
    ).encode("utf-8")


class GatewayHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = f"{PRODUCT_NAME}/{PRODUCT_VERSION}"
    sys_version = ""

    # No request logging: no token may ever reach logs.
    def log_message(self, format: str, *args: object) -> None:  # noqa: A002
        return

    def do_GET(self) -> None:  # noqa: N802
        self._dispatch("GET")

    def do_HEAD(self) -> None:  # noqa: N802
        self._dispatch("HEAD")

    def __getattr__(self, name: str):
        # Any verb without an explicit do_<METHOD> routes the same way, so a
        # non-GET request on a known path still yields 405 rather than 501.
        if name.startswith("do_") and len(name) > 3:
            return self._dispatch_other
        raise AttributeError(name)

    def _dispatch_other(self) -> None:
        self._dispatch(self.command)

    def _dispatch(self, method: str) -> None:
        gateway: Gateway = self.server.gateway  # type: ignore[attr-defined]
        try:
            split = urlsplit(self.path)
            path = split.path
        except ValueError:
            self._send_json(404, {"error": "not_found"}, head=method == "HEAD")
            return

        if path not in ("/health", "/proxy"):
            self._send_json(404, {"error": "not_found"}, head=method == "HEAD")
            return
        if method != "GET":
            self._send_json(405, {"error": "method_not_allowed"}, head=method == "HEAD")
            return
        if path == "/health":
            self._send_json(200, {"status": "ok"})
            return

        auth_values = self.headers.get_all("Authorization") or []
        if len(auth_values) != 1 or auth_values[0] != "Bearer " + gateway.token:
            self._send_json(401, {"error": "unauthorized"})
            return

        try:
            allowed = gateway.reserve()
        except ClockError:
            self._send_json(503, {"error": "clock_error"})
            return
        if not allowed:
            self._send_json(429, {"error": "rate_limited"})
            return

        self._forward(split.query)

    def _forward(self, query: str) -> None:
        gateway: Gateway = self.server.gateway  # type: ignore[attr-defined]
        target = "/" + ("?" + query if query else "")
        connection = http.client.HTTPConnection(
            "127.0.0.1", gateway.upstream_port, timeout=UPSTREAM_TIMEOUT_SECONDS
        )
        error_code: str | None = None
        status = 502
        content_type = "application/octet-stream"
        body = b""
        try:
            connection.request("GET", target)
            response = connection.getresponse()
            status = response.status
            if not 200 <= status <= 599:
                error_code = "upstream_error"
            else:
                content_type = (
                    response.getheader("Content-Type") or "application/octet-stream"
                )
                declared = response.getheader("Content-Length")
                too_large = False
                if declared is not None:
                    try:
                        too_large = int(declared) > MAX_UPSTREAM_BODY
                    except ValueError:
                        too_large = False
                if too_large:
                    error_code = "upstream_too_large"
                else:
                    body = response.read(MAX_UPSTREAM_BODY + 1)
                    if len(body) > MAX_UPSTREAM_BODY:
                        error_code = "upstream_too_large"
        except (OSError, http.client.HTTPException, ValueError):
            error_code = "upstream_error"
        finally:
            connection.close()

        if error_code is not None:
            self._send_json(502, {"error": error_code})
        else:
            self._send_upstream(status, content_type, body)

    def _send_json(
        self, status: int, payload: dict[str, object], *, head: bool = False
    ) -> None:
        body = _json_bytes(payload)
        try:
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            if head:
                self.send_header("Content-Length", "0")
                self.end_headers()
            else:
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
        except OSError:
            self.close_connection = True

    def _send_upstream(self, status: int, content_type: str, body: bytes) -> None:
        try:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except OSError:
            self.close_connection = True


class GatewayServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, address: tuple[str, int], gateway: Gateway) -> None:
        self.gateway = gateway
        super().__init__(address, GatewayHandler)


def run(argv: list[str]) -> int:
    parsed = parse_arguments(argv)
    action = parsed["action"]
    if action == "version":
        _write_stdout(f"{PRODUCT_NAME} {PRODUCT_VERSION}\n")
        return 0
    if action == "help":
        _write_stdout(HELP_TEXT)
        return 0

    config_path = str(parsed["config"])
    port = int(parsed["port"])  # type: ignore[arg-type]
    clock_file = parsed["clock_file"]
    config = load_config(config_path)

    gateway = Gateway(
        upstream_port=int(config["upstream_port"]),  # type: ignore[arg-type]
        token=str(config["token"]),
        limit=int(config["limit"]),  # type: ignore[arg-type]
        window_ms=int(config["window_ms"]),  # type: ignore[arg-type]
        clock_file=str(clock_file) if clock_file is not None else None,
    )
    _serve(gateway, port)
    return 0


def _serve(gateway: Gateway, port: int) -> None:
    try:
        server = GatewayServer(("127.0.0.1", port), gateway)
    except OSError as exc:
        _write_stderr(f"error: cannot bind 127.0.0.1:{port}: {exc.strerror or exc}\n")
        raise SystemExit(1) from None

    real_port = server.server_address[1]
    _write_stdout(json.dumps({"port": real_port}, separators=(",", ":")) + "\n")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]
    try:
        return run(argv)
    except CliError as exc:
        _write_stderr(f"error: {exc.message}\n")
        return exc.exit_code


if __name__ == "__main__":
    sys.exit(main())
